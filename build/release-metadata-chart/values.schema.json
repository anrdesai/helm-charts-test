{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "ReleaseMetadata",
  "description": "Versioned cleanroom release metadata contract carried in values.yaml.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "images"],
  "properties": {
    "apiVersion": {
      "type": "string",
      "description": "Contract API version.",
      "const": "metadata.cleanroom.azure.com/v1"
    },
    "kind": {
      "type": "string",
      "const": "ReleaseMetadata"
    },
    "metadata": {
      "type": "object",
      "required": ["release"],
      "properties": {
        "release": {
          "type": "string",
          "description": "Release/catalog version; matches Chart.yaml version."
        },
        "published": {
          "type": "string",
          "description": "Publish date (ISO-8601), informational."
        }
      },
      "additionalProperties": true
    },
    "images": {
      "type": "object",
      "description": "Logical image name -> full container reference (digest-pinned or tag-based).",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": true
}
